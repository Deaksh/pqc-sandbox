{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CryptoScan",
          "version": "1.0.0",
          "rules": [
            {
              "id": "CRYPTO001",
              "name": "WeakRSA",
              "shortDescription": { "text": "RSA key size below 3072 bits" }
            },
            {
              "id": "CRYPTO002",
              "name": "ECDSAUsage",
              "shortDescription": { "text": "ECDSA detected - quantum-vulnerable" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CRYPTO001",
          "message": { "text": "RSA-2048 key detected. Vulnerable to quantum computers running Shor's algorithm." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/auth/jwt.py" },
                "region": { "startLine": 42 }
              }
            }
          ]
        },
        {
          "ruleId": "CRYPTO002",
          "message": { "text": "ECDSA-P256 used for TLS certificate signing. Not quantum-safe." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config/tls_config.yaml" },
                "region": { "startLine": 17 }
              }
            }
          ]
        }
      ]
    }
  ]
}
